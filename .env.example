# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Clé API OpenRouter facultative par défaut si définie dans l'environnement serveur
OPENROUTER_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Cloud Synchronization (Firestore)
VITE_FIREBASE_PROJECT_ID="gen-lang-client-0629460348"
VITE_FIREBASE_API_KEY="AIzaSyBp3hK-6JqWStVIlJfyn_aga8qpgPZV2Bo"
VITE_FIREBASE_APP_ID="1:906686108779:web:241a3c262975dc42e74d2e"
VITE_FIREBASE_DATABASE_ID="ai-studio-8f8ea797-b318-427d-a871-c5c5b42d68e8"

